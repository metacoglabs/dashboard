# Base URL of the Tex integration backend. No trailing slash.
# Cloud (default):  https://api.getmetacognition.com
# Local dev:        http://localhost:8000
TEX_API_BASE_URL=https://api.getmetacognition.com

# Cookie signing secret. Generate with: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-string
